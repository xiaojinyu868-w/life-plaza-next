# Runtime configuration only. Keep real values outside Git.
HOST=127.0.0.1
PORT=5198
WORKSHOP_DATA_DIR=./data

# Full OpenAI-compatible chat/completions endpoint; no implicit provider or billing.
# Existing DASHSCOPE_API_KEY is not read automatically. If using that provider,
# bind it to the selected WORKSHOP_*_API_KEY only in the server process environment.
# Configure the matching endpoint and model explicitly; saving this file does not activate a running process.
WORKSHOP_LLM_URL=
WORKSHOP_LLM_API_KEY=
WORKSHOP_LLM_MODEL=
WORKSHOP_LLM_SESSION_LIMIT=30

# Full OpenAI-compatible audio/transcriptions endpoint (L1 transcription only).
WORKSHOP_ASR_URL=
WORKSHOP_ASR_API_KEY=
WORKSHOP_ASR_MODEL=
WORKSHOP_SPEECH_SESSION_LIMIT=80

# Optional private pronunciation adapter implementing docs/ API contract.
# It must return measured phones and tone.valid=true/ref/got per character.
# transcriptSource must explicitly be recognition before any transcript is used as an answer.
WORKSHOP_ASSESSMENT_URL=
WORKSHOP_ASSESSMENT_API_KEY=

# Optional Tencent SOE Chinese read assessment (takes precedence over private adapter).
# Enable only after the deployment region and provider data terms are confirmed.
# These are server-side credentials; never put them in browser code. See docs/TENCENT-SOE.md.
WORKSHOP_TENCENT_APP_ID=
WORKSHOP_TENCENT_SECRET_ID=
WORKSHOP_TENCENT_SECRET_KEY=
WORKSHOP_TENCENT_SCORE_COEFF=1

# Reuse an existing corpus token; the server never signs in or invalidates other keys.
WORKSHOP_CORPUS_TOKEN=
WORKSHOP_CORPUS_DAILY_LIMIT=100
WORKSHOP_MAX_CONCURRENT=8

# Required when listening beyond loopback. Terminate HTTPS at a reverse proxy.
WORKSHOP_PUBLIC_ORIGIN=
WORKSHOP_TEACHER_TOKEN=
